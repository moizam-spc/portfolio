  .proj .win{font-family:"IBM Plex Mono",monospace; font-size:11px; color:var(--plasma-dk); font-weight:600; margin-top:10px; display:block}

  /* leadership cards w/ image */
  .lead-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:18px}
  @media(max-width:760px){ .lead-grid{grid-template-columns:1fr} }
  .lcard{border:1px solid var(--line); background:var(--card); border-radius:14px; overflow:hidden; display:flex; flex-direction:column}
  .lcard img{display:block; width:100%; height:170px; object-fit:cover; border-bottom:1px solid var(--line)}
