  .contact p{color:#CBD5E3; max-width:560px; margin:0 0 24px}
  .contact .cta-row{margin-top:0}
  footer{background:var(--ink); color:#8FA0B8; padding:26px 0 40px}
  footer .wrap{display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;
    border-top:1px solid var(--line-dk); padding-top:22px}
  footer .fmono{font-family:"IBM Plex Mono",monospace; font-size:12px; letter-spacing:.05em}
  footer a{color:var(--plasma); text-decoration:none; font-family:"IBM Plex Mono",monospace; font-size:13px}
  footer a:hover{text-decoration:underline}
</style>
