  .panel{border:1px solid var(--line); background:var(--card); border-radius:14px; padding:22px 24px}
  .panel h3{font-family:"Archivo",sans-serif; font-weight:700; font-size:16px; margin:0 0 12px}
  .panel .item{margin-bottom:12px}
  .panel .item:last-child{margin-bottom:0}
  .panel .it-t{font-weight:600; font-size:14.5px}
  .panel .it-s{font-size:13px; color:var(--muted)}
  .kv{margin:0}
